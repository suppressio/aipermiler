{
  "name": "aipermiler",
  "productName": "AIpermiler",
  "version": "0.6.1-beta",
  "description": "Desktop widget that monitors AI token usage (Claude, GitHub Copilot and Codex) and computes an optimal daily budget.",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "tsc -p tsconfig.renderer.json && tsc -p tsconfig.renderer.test.json",
    "copy-assets": "node scripts/copy-assets.js",
    "build:core": "node scripts/build-core.js",
    "build": "npm run clean && npm run build:main && npm run build:renderer && npm run copy-assets",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "start": "npm run build && node scripts/build-core.js --dev && electron .",
    "test": "npm run build && cd dist && node --env-file-if-exists=../.env.test --test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.renderer.test.json --noEmit",
    "coverage": "npm run build && cd dist && node --test --experimental-test-coverage --test-coverage-exclude=\"**/*.test.js\" --test-coverage-exclude=\"tests/**\"",
    "package": "npm run build && npm run build:core && electron-builder",
    "package:test": "node scripts/test-build.js"
  },
  "author": "Daniele 'suppressio' <82306300+suppressio@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/suppressio/aipermiler",
  "repository": {
    "type": "git",
    "url": "https://github.com/suppressio/aipermiler.git"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "date-fns": "^4.4.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-store": "^8.2.0",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "build": {
    "appId": "com.suppressio.aipermiler",
    "beforePack": "scripts/bundle-main.js",
    "icon": "build/icon.png",
    "electronLanguages": [
      "en-US",
      "it"
    ],
    "extraResources": [
      {
        "from": "core-bin",
        "to": "core",
        "filter": [
          "aipermiler",
          "aipermiler.exe"
        ]
      }
    ],
    "files": [
      "dist/main.js",
      "dist/preload.js",
      "dist/services/claudeLocalSessions.worker.js",
      "dist/renderer/**/*",
      "!dist/renderer/**/*.test.js",
      "!dist/renderer/**/*.map",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "releaseType": "prerelease"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "guid": "33e92a1e-bfee-5ad0-a902-f1cafb612da7"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "desktop": {
        "entry": {
          "Name": "AIpermiler"
        }
      },
      "category": "Utility"
    },
    "deb": {
      "fpm": [
        "build/linux/com.suppressio.aipermiler.metainfo.xml=/usr/share/metainfo/com.suppressio.aipermiler.metainfo.xml"
      ]
    }
  }
}
